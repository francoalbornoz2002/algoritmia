[resource]
script = ExtResource("2_f4xsc")
id = "d9eebc99-9c0b-4ef8-bb6d-6bb9bd380a20"
numero = 10
titulo = "Tutorial 10: Puentes"
descripcion = "El terreno, a veces, tiene fosas de agua y solo se pueden atravesar mediante un puente, pero debes pagar peaje. Necesitas una moneda para poder activar el puente. Avanza 3 casillas y si encuentras una moneda, recógela. Luego, utiliza el sensor hayPuente para ver si hay uno. ¡Recuerda verificar si tienes una moneda para pagar! activa el puente y avanza 3 casillas más. Si no hay puente o no puedes activarlo, da media vuelta y vuelve al inicio."
es_tutorial = true
casos_de_prueba = Array[ExtResource("1_f2gp5")]([SubResource("Resource_cd2af"), SubResource("Resource_xfx52"), SubResource("Resource_nfrr7")])
metadata/_custom_type_script = "uid://7dwqqmri6ibf"

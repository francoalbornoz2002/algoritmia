[resource]
script = ExtResource("2_nlwwl")
id = "b3eebc99-9c0b-4ef8-bb6d-6bb9bd380a24"
numero = 14
titulo = "Tutorial 14: Bucles 2"
descripcion = "Al igual que el Emblema del Juicio, El Orbe del Ciclo Infinito también te permite realizar acciones mientras se cumplan dos o más condiciones usando el conectivo AND. Recorre todo el sendero 1 hasta encontrar una moneda. Si la encuentras, recógela, gira a la derecha y recorre el valle hasta el final. Si no encuentras la moneda, da media vuelta y vuelve al inicio."
dificultad_mision = "Medio"
es_tutorial = true
casos_de_prueba = Array[ExtResource("1_f2bst")]([SubResource("Resource_0hia0"), SubResource("Resource_fb6i0")])
metadata/_custom_type_script = "uid://7dwqqmri6ibf"

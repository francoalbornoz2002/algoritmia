[resource]
script = ExtResource("2_aini5")
id = "f5eebc99-9c0b-4ef8-bb6d-6bb9bd380a16"
numero = 6
titulo = "Tutorial 6: Decisiones 2"
descripcion = "¡Más decisiones!. El emblema del juicio no solo sirve para hacer algo si y solo si se cumple algo, tambien puedes especificar si quieres hacer OTRA COSA si no se cumple dicha condición. Avanza 3 casillas y utiliza el sensor 'hayEnemigo' para verificar si hay un enemigo. Si hay, atácalo, gira a la dercha y avanza dos casillas más. Sino, sigue tu camino y avanza 3 casillas más."
es_tutorial = true
casos_de_prueba = Array[ExtResource("1_2lnmm")]([SubResource("Resource_3lf4w"), SubResource("Resource_moub1")])
metadata/_custom_type_script = "uid://7dwqqmri6ibf"

[resource]
script = ExtResource("2_b6e65")
id = "d5eebc99-9c0b-4ef8-bb6d-6bb9bd380a26"
numero = 16
titulo = "Tutorial 16: Bucles 4"
descripcion = "¡Negador! Tambien puedes usar el NOT para negar las proposiciones usando el Orbe del Ciclo Infinito. Recorre todo el sendero 1 mientras no encuentres una moneda. Si la encuentras, gira a la derecha y recorre todo el valle en el que te encuentres. Si no la encuentras, da media vuelta y vuelve al inicio."

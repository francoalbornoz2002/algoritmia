[resource]
script = ExtResource("2_53u5s")
id = "c4eebc99-9c0b-4ef8-bb6d-6bb9bd380a25"
numero = 15
titulo = "Tutorial 15: Bucles 3 (OR)"
descripcion = "O esto o lo otro... una de dos. Tambien puedes usar el conectivo OR en el Orbe del Ciclo Infinito para evaluar si al menos una de las proposiciones se cumple para continuar. Recorre todo el sendero 1 hasta encontrar una moneda y una llave en la misma casilla, es algo raro de ver asi que habrán enemigos al asecho. Cuando las encuentres, recógelas, gira a la derecha y avanza 10 casillas. Si no las encuentras hasta el final del sendero, da media vuelta y retrocede 10 casillas."
dificultad_mision = "Media"
casos_de_prueba = Array[ExtResource("1_s08u3")]([SubResource("Resource_d2hhj"), SubResource("Resource_jh264")])
metadata/_custom_type_script = "uid://7dwqqmri6ibf"

[ext_resource type="Script" path="res://scripts/feedback/feedback_dificultad.gd" id="1_script_feedback"]

[resource]
script = ExtResource("1_script_feedback")
codigo_dificultad = "SL-02"
titulo = "¡Cuidado al recolectar!"
texto_formativo = "Notamos que a veces intentas recolectar objetos sin verificar si realmente están ahí. ¡Recuerda usar siempre el Emblema del Juicio con los sensores correspondientes antes de actuar!"
codigo_incorrecto = "recogerMoneda"
codigo_correcto = "Si hayMoneda entonces:
	recogerMoneda"